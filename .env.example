# Base URL of the stcbe backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Must match the backend's JWT_SECRET exactly - used server-side only
# (in middleware.ts) to verify the session cookie and read the user's role
# for route guarding. Never expose this as NEXT_PUBLIC_*.
JWT_SECRET=

# WhatsApp number for the "Chat with us" links on campaign landing pages
# (/go/:slug), digits only with country code, e.g. 2347089118528. Falls back
# to the WhatsApp number in the default contact details when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=2347089118528
